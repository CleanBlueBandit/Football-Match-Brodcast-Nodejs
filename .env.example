# Postgres connection string (used by Prisma, the app and the session store)
DATABASE_URL="postgresql://user:password@localhost:5432/broadcast"
# Set to false for a local Postgres without SSL
# DB_SSL=false
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=3000
# Standings import on server start: "missing" (default, only adds new teams),
# "overwrite" (reset standings to the file's values) or "off"
# STANDINGS_IMPORT=missing
# JSON file to import (default: prisma/seed/league.json)
# STANDINGS_FILE=prisma/seed/league.json
